{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/registrar-farm",
      "destination": "/paginas/registrar-farm.html"
    },
    {
      "source": "/desempenho",
      "destination": "/paginas/desempenho.html"
    },
    {
      "source": "/historico",
      "destination": "/paginas/historico.html"
    },
    {
      "source": "/rankings",
      "destination": "/paginas/rankings.html"
    },
    {
      "source": "/ajuda",
      "destination": "/paginas/ajuda.html"
    },
    {
      "source": "/ferramentas/onde-vender-loot",
      "destination": "/paginas/onde-vender-loot.html"
    },
    {
      "source": "/ferramentas/comparar-hunts",
      "destination": "/paginas/comparar-hunts.html"
    },
    {
      "source": "/ferramentas/custos-de-hunts",
      "destination": "/paginas/custos-de-hunts.html"
    },
    {
      "source": "/ferramentas/previsao-de-farm",
      "destination": "/paginas/previsao-de-farm.html"
    },
    {
      "source": "/ferramentas/divisor-party-hunt",
      "destination": "/paginas/divisor-party-hunt.html"
    },
    {
      "source": "/ferramentas/calculadora-party-xp",
      "destination": "/paginas/calculadora-party-xp.html"
    },
    {
      "source": "/ferramentas/bestiario-de-hunt",
      "destination": "/paginas/bestiario-de-hunt.html"
    },
    {
      "source": "/ferramentas/cacar-por-elemento",
      "destination": "/paginas/cacar-por-elemento.html"
    },
    {
      "source": "/politica-de-privacidade",
      "destination": "/paginas/politica-de-privacidade.html"
    },
    {
      "source": "/termos-de-uso",
      "destination": "/paginas/termos-de-uso.html"
    },
    {
      "source": "/contato",
      "destination": "/paginas/contato.html"
    },
    {
      "source": "/sobre",
      "destination": "/paginas/sobre.html"
    },
    {
      "source": "/guias",
      "destination": "/guias/index.html"
    },
    {
      "source": "/guias/:slug",
      "destination": "/guias/:slug.html"
    },
    {
      "source": "/ferramentas/conversor-tc",
      "destination": "/paginas/conversor-tc.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}